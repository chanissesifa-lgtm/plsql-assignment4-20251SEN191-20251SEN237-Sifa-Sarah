cells:
  - kind: 2
    value: "\r

      SET SERVEROUTPUT ON;\r

      \r

      DECLARE\r

      \    v_dummy_id NUMBER;\r

      \    v_gpa NUMBER;\r

      BEGIN\r

      \    DBMS_OUTPUT.PUT_LINE(' RUNNING ERROR EXCEPTION TEST CASES ');\r

      \r

      \    -- 1. Test Duplicate Registration Error (Unique Constraint
      Violation)\r

      \    BEGIN\r

      \        register_student(\r

      \            p_first_name => 'Duplicate',\r

      \            p_last_name  => 'User',\r

      \            p_email      => 'alice.uwase@auca.ac.rw', -- Already exists\r

      \            p_student_id => v_dummy_id\r

      \        );\r

      \    EXCEPTION\r

      \        WHEN OTHERS THEN\r

      \            DBMS_OUTPUT.PUT_LINE('Caught Expected Error: ' || SQLERRM);\r

      \    END;\r

      \r

      \    -- 2. Test NO_DATA_FOUND Error in Function\r

      \    BEGIN\r

      \        v_gpa := calculate_student_gpa(99999); -- Non-existent student
      ID\r

      \    EXCEPTION\r

      \        WHEN OTHERS THEN\r

      \            DBMS_OUTPUT.PUT_LINE('Caught Expected Error: ' || SQLERRM);\r

      \    END;\r

      \r

      \    DBMS_OUTPUT.PUT_LINE('=== ALL ERROR TESTS COMPLETED ===');\r

      END;\r

      /\r

      \r\n"
    languageId: oracle-sql
